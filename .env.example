# Copy to .env and fill in, or run ./scripts/init-env.sh, which copies this file. Each key is
# tagged:
#   REQUIRED  - uncommented; the agent refuses to start without it.
#   OPTIONAL  - commented out at its default; uncomment to change it.
#   TEST-ONLY - commented out; leave unset, the tests and validate.sh set it.
# A variable already exported in the calling shell wins over the same key here, and a blank value
# counts as unset. Every setting is read once, at startup.

# -- Agent ---------------------------------------------------------------------------
# OPTIONAL - port the agent listens on (default 8030). Under Docker it is only the host port; the
# container always listens on 8030. When you change it, change AGENT_URL to match.
# SERVER_PORT=8030
# OPTIONAL - the URL callers reach the agent at (default http://localhost:<SERVER_PORT>),
# published in the Agent Card; an A2A client calls this URL, not the one it fetched the card from,
# so it must carry the port above. A caller running in Docker on this machine reaches the agent
# as http://host.docker.internal:8030; a caller elsewhere by this machine's hostname.
# AGENT_URL=http://localhost:8030
# REQUIRED - root of the statement folders, one sub-folder per person named by their Google
# account id, holding the monthly statements downloaded from the card site. It starts empty; the
# statements page loads PDFs into the signed-in person's folder. start.sh creates it, a relative
# path under the repo, and the agent refuses to start when it is not an existing directory.
STATEMENTS_DIR=./statements

# OPTIONAL - the folder holding statements.html (default ./static); the image sets /app/static.
# The agent refuses to start when the page is not there.
# STATIC_DIR=./static

# -- Access --------------------------------------------------------------------------
# OPTIONAL - require credentials (default true): every A2A call carries the signed-in person's
# Google ID token as the bearer token and a registered caller's secret in X-Caller-Secret, and
# the statements API needs the person's token. The card, the health route, the statements page
# and /api/auth/config are always open. With it off there is one person, "anonymous", and no
# token or secret is read.
# A2A_AUTH_REQUIRED=true
# REQUIRED while access is required - this agent's own Google OAuth client id (a "Web
# application" client in its own Google Cloud project, with this agent's origin as an authorized
# JavaScript origin). The statements page signs in with it, and tokens sent to that page must be
# issued to it.
AUTH_CLIENT_ID=
# OPTIONAL - the file registering the A2A callers (default ./allowed-callers.yaml), written by
# ./scripts/register-caller.sh: for each caller its name, the secret it presents and the Google
# OAuth client id whose tokens it forwards. While access is required, startup refuses an empty
# file, a caller with a blank field and two callers sharing a secret or a name.
# A2A_CALLERS_FILE=./allowed-callers.yaml
# OPTIONAL - who issues the tokens and where its public keys are published. The defaults are
# Google's; both are read only when a token is verified.
# AUTH_ISSUER=https://accounts.google.com
# AUTH_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
# TEST-ONLY - a PEM public key that replaces AUTH_JWKS_URL, so tests can sign their own tokens.
# AUTH_PUBLIC_KEY_FILE=

# -- Categorization ------------------------------------------------------------------
# REQUIRED - provider:model, anthropic or openai. Classifying merchants with a usable confidence
# score wants the Haiku or mini tier, not the smallest one: anthropic:claude-haiku-5-5 or
# openai:gpt-5-mini. The value keyword selects a fixed keyword table that needs no API key; the
# tests and validate.sh use it.
LLM_MODEL=anthropic:claude-haiku-5-5
# REQUIRED unless LLM_MODEL is keyword - the API key of the provider LLM_MODEL names.
LLM_API_KEY=
# OPTIONAL - the model's score (0 to 1) from which a row's confidence is reported as "high"
# (default 0.85) and as "medium" (default 0.6); below the medium one it is "low". Startup refuses
# a medium threshold above the high one or either outside 0 to 1.
# CATEGORIZER_HIGH_CONFIDENCE=0.85
# CATEGORIZER_MEDIUM_CONFIDENCE=0.6
# OPTIONAL - how many not-yet-seen merchants go to the model in one call (default 40, at least 1).
# CATEGORIZER_BATCH_SIZE=40

# -- Tasks ---------------------------------------------------------------------------
# OPTIONAL - Redis shared by the replicas: the A2A tasks and their events, so a task paused by one
# replica can be continued or followed on any, even after a restart; which replica runs each task;
# and the merchant categories remembered per person. When unset, all of it stays in the process's
# memory, for a single replica.
# TASKS_REDIS_URL=redis://localhost:6379/0
# OPTIONAL - how long Redis keeps a task after its last change, as an ISO 8601 duration or a
# number of seconds (default P30D).
# TASKS_TTL=P30D
# OPTIONAL - seconds a task's lease, which only the call running the task holds, lasts unless
# renewed (default 60, at least 1); the running call renews it every third of this. With Redis,
# each replica also checks this often for working tasks nobody holds, left by a replica that
# stopped, and fails them so the caller can start again.
# TASK_LEASE_SECONDS=60
# TEST-ONLY - "tck" swaps in the scenario executor the conformance suite needs and turns access
# off; validate.sh --tck sets it. The default is "card".
# A2A_EXECUTOR=card
# TEST-ONLY - milliseconds every call to the classifier waits first (default 0), so the
# multi-replica tests can act while a task is still working.
# CAL_TEST_SLOW_MS=0

# -- Logging -------------------------------------------------------------------------
# OPTIONAL - level for the agent (default INFO) and for the A2A SDK (default WARNING).
# LOG_LEVEL=INFO
# A2A_LOG_LEVEL=WARNING
